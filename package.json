{
  "name": "mural-fotos",
  "version": "1.0.0",
  "private": true,
  "description": "Mural de Fotos – envio por QR Code e transmissão em tempo real para projetor",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./data/** --ignore ./.next/** server/start.ts",
    "build": "next build",
    "start": "tsx server/start.ts --prod",
    "setup": "tsx scripts/setup.ts",
    "set-password": "tsx scripts/setup.ts --password-only",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "postcss": "^8.5.33",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
