# ============================================================
#  MURAL DE FOTOS – configuração
#  Copie este arquivo para ".env" (ou execute install.bat / npm run setup,
#  que gera o .env automaticamente e de forma segura).
#  NUNCA coloque senhas em texto puro aqui.
# ============================================================

# Porta HTTP do servidor (o celular acessa http://IP-DO-COMPUTADOR:PORTA)
PORT=3000

# Interface de rede. 0.0.0.0 = aceita conexões de outros aparelhos da rede.
HOST=0.0.0.0

# Endereço público PERMANENTE usado no QR Code (modo remoto, ex.: domínio + Cloudflare Tunnel).
# Deixe vazio para usar o modo local (IP do computador na rede Wi-Fi).
# Exemplo ilustrativo: https://fotos.meudominio.com.br
PUBLIC_BASE_URL=

# Hash da senha administrativa (formato scrypt). Gere com:  npm run set-password
ADMIN_PASSWORD_HASH=

# Segredo para assinar as sessões (texto aleatório longo). Gerado pelo "npm run setup".
SESSION_SECRET=

# Pasta onde ficam fotos e metadados (padrão: ./data)
DATA_DIR=./data

# Defina como 1 quando o sistema estiver atrás de um proxy/túnel confiável
# (ex.: Cloudflare Tunnel) para usar o IP real do visitante no rate limiting.
TRUST_PROXY=0

# Origens extras permitidas para Socket.IO e operações administrativas (separadas por vírgula).
ALLOWED_ORIGINS=
